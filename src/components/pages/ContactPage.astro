---
import BaseHead from '../BaseHead.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { Mail } from '@lucide/astro';
import '../../styles/global.css';
import forumIcon from '../../assets/links-forums.png';
import { getLocale, langOf, localizePath, rich, t, type MessageKey } from '../../i18n';

const locale = getLocale(Astro.url.pathname);
const lang = langOf(locale);
const contactEmail = 'contact@ksp2redux.org';
const emailLink = {
	emailLink: { tag: 'a', attrs: { href: `mailto:${contactEmail}`, class: 'text-ksp-red-text underline underline-offset-2' } },
} as const;

// Names are not translated, only what each lead is responsible for.
const teamLeads = [
	{ id: 'foonix', name: 'Foonix' },
	{ id: 'munix', name: 'munix' },
	{ id: 'shadowdev', name: 'ShadowDev' },
	{ id: 'infinity', name: 'Infinity' },
	{ id: 'safarte', name: 'Safarte' },
	{ id: 'dan', name: 'dan' },
].map(({ id, name }) => ({
	name,
	responsibilities: t(locale, `contact.team.${id}.responsibilities` as MessageKey),
}));
---

<!DOCTYPE html>
<html lang={lang}>
<head>
	<BaseHead
		title={t(locale, 'contact.meta.title')}
		description={t(locale, 'contact.meta.description')}
	/>
</head>
<body class="bg-space-black text-white min-h-screen">
	<Header />

	<main class="page-main">

	<section class="page-hero pt-32 pb-16">
		<div class="absolute inset-0 z-0" style="background-image: url('/background.webp'); background-size: cover; background-position: center;"></div>
		<div class="absolute inset-0 z-0 bg-gradient-to-r from-space-black via-space-black/80 to-space-black/20"></div>
		<div class="absolute inset-0 z-0 bg-gradient-to-b from-transparent via-space-black/25 to-space-black"></div>

		<div class="section-container relative z-10">
			<div class="max-w-4xl">
				<h1 class="page-title">
					{t(locale, 'contact.hero.titleLead')}{' '}
					<span>{t(locale, 'contact.hero.titleAccent')}</span>
				</h1>
				<p class="page-intro">
					{t(locale, 'contact.hero.intro')}
				</p>
			</div>
		</div>
	</section>

	<section class="section-container py-16">
		<div class="page-section-heading">
			<h2>{t(locale, 'contact.channels.heading')}</h2>
			<p>
				{t(locale, 'contact.channels.intro')}
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
			<a 
				href="https://discord.gg/ksp2redux" 
				target="_blank"
				rel="noopener noreferrer"
				class="card-glass text-center border border-transparent hover:border-ksp-red/40"
			>
				<div class="text-6xl mb-4">
					<svg class="w-16 h-16 mx-auto text-ksp-red" fill="currentColor" viewBox="0 0 24 24">
						<path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
					</svg>
				</div>
				<h3 class="text-2xl font-heading font-bold mb-3">Discord</h3>
				<p class="text-gray-400 mb-4">
					{t(locale, 'contact.channels.discord.description')}
				</p>
				<span class="text-ksp-red-text font-semibold">
					{t(locale, 'contact.channels.discord.action')}
				</span>
			</a>

			<a 
				href="https://github.com/KSP2Redux/Redux" 
				target="_blank"
				rel="noopener noreferrer"
				class="card-glass text-center border border-transparent hover:border-ksp-red/40"
			>
				<div class="text-6xl mb-4">
					<svg class="w-16 h-16 mx-auto text-ksp-red" fill="currentColor" viewBox="0 0 24 24">
						<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
					</svg>
				</div>
				<h3 class="text-2xl font-heading font-bold mb-3">GitHub</h3>
				<p class="text-gray-400 mb-4">
					{t(locale, 'contact.channels.github.description')}
				</p>
				<span class="text-ksp-red-text font-semibold">
					{t(locale, 'contact.channels.github.action')}
				</span>
			</a>

			<a 
				href="https://reddit.com/r/KSP2Redux" 
				target="_blank"
				rel="noopener noreferrer"
				class="card-glass text-center border border-transparent hover:border-ksp-red/40"
			>
				<div class="text-6xl mb-4">
					<svg class="w-16 h-16 mx-auto text-ksp-red" fill="currentColor" viewBox="0 0 24 24">
						<path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701z"/>
					</svg>
				</div>
				<h3 class="text-2xl font-heading font-bold mb-3">Reddit</h3>
				<p class="text-gray-400 mb-4">
					{t(locale, 'contact.channels.reddit.description')}
				</p>
				<span class="text-ksp-red-text font-semibold">
					{t(locale, 'contact.channels.reddit.action')}
				</span>
			</a>

			<a 
				href="https://forum.kerbalspaceprogram.com/topic/231578-ksp2-redux-v0285/"
				target="_blank"
				rel="noopener noreferrer"
				class="card-glass text-center border border-transparent hover:border-ksp-red/40"
			>
				<div class="text-6xl mb-4">
					<span
						class="contact-forum-icon mx-auto text-ksp-red"
						style={`-webkit-mask-image: url('${forumIcon.src}'); mask-image: url('${forumIcon.src}');`}
						aria-hidden="true"
					></span>
				</div>
				<h3 class="text-2xl font-heading font-bold mb-3">KSP Forums</h3>
				<p class="text-gray-400 mb-4">
					{t(locale, 'contact.channels.forum.description')}
				</p>
				<span class="text-ksp-red-text font-semibold">
					{t(locale, 'contact.channels.forum.action')}
				</span>
			</a>
		</div>

		<div class="page-section-heading">
			<h2>{t(locale, 'contact.startingPoints.heading')}</h2>
			<p>
				{t(locale, 'contact.startingPoints.intro')}
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			<div class="card-glass">
				<h3 class="text-2xl font-heading font-bold mb-4 flex items-center">
					<svg class="w-6 h-6 mr-3 text-ksp-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
					</svg>
					{t(locale, 'contact.startingPoints.docs.title')}
				</h3>
				<p class="text-gray-400 mb-4">
					{t(locale, 'contact.startingPoints.docs.description')}
				</p>
				<a href={localizePath('/guides/', locale)} class="btn-primary">
					{t(locale, 'contact.startingPoints.docs.action')}
				</a>
			</div>

			<div class="card-glass">
				<h3 class="text-2xl font-heading font-bold mb-4 flex items-center">
					<svg class="w-6 h-6 mr-3 text-ksp-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
					</svg>
					{t(locale, 'contact.startingPoints.issues.title')}
				</h3>
				<p class="text-gray-400 mb-4">
					{t(locale, 'contact.startingPoints.issues.description')}
				</p>
				<a href="https://github.com/KSP2Redux/Redux/issues" target="_blank" rel="noopener noreferrer" class="btn-primary">
					{t(locale, 'contact.startingPoints.issues.action')}
				</a>
			</div>
		</div>
	</section>

	<section class="section-container py-10">
		<div class="card-glass text-center py-12 px-8">
			<h2 class="text-4xl font-heading font-bold mb-6">
				{t(locale, 'contact.faq.heading')}
			</h2>
			<p class="text-gray-400 mb-8 max-w-2xl mx-auto text-lg">
				{t(locale, 'contact.faq.description')}
			</p>
			<a href={localizePath('/faq/', locale)} class="btn-primary text-lg">
				<svg class="w-5 h-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
				</svg>
				{t(locale, 'contact.faq.action')}
			</a>
		</div>
	</section>

	<section class="section-container py-20">
		<div class="page-section-heading mx-auto text-center">
			<h2>{t(locale, 'contact.team.heading')}</h2>
			<p>
				{t(locale, 'contact.team.intro')}
			</p>
		</div>

		<div class="overflow-x-auto">
			<table class="w-full border-collapse">
				<thead>
					<tr class="border-b-2 border-ksp-red">
						<th class="text-left py-4 px-6 font-heading font-bold text-ksp-red-text">{t(locale, 'contact.team.column.lead')}</th>
						<th class="text-left py-4 px-6 font-heading font-bold text-ksp-red-text">{t(locale, 'contact.team.column.responsibilities')}</th>
					</tr>
				</thead>
				<tbody>
					{teamLeads.map((lead, index) => (
						<tr class:list={[index < teamLeads.length - 1 && 'border-b border-gray-700', 'hover:bg-gray-900/30 transition-colors']}>
							<td class="py-4 px-6 font-semibold text-white">{lead.name}</td>
							<td class="py-4 px-6 text-gray-300">{lead.responsibilities}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>

		<p class="text-center text-gray-400 mt-8 text-sm">
			{t(locale, 'contact.team.noteDiscord')}<br/>
			<Fragment set:html={rich(locale, 'contact.team.noteBusiness', emailLink, { email: contactEmail })} />
		</p>
	</section>

	<section class="section-container py-20">
		<div class="card-glass text-center py-12">
			<h2 class="text-3xl md:text-4xl font-heading font-bold mb-4">
				{t(locale, 'contact.ask.heading')}
			</h2>
			<p class="text-gray-400 mb-6 max-w-xl mx-auto" set:html={rich(locale, 'contact.ask.description', emailLink, { email: contactEmail })} />
			<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
				<a href="https://discord.gg/ksp2redux" target="_blank" rel="noopener noreferrer" class="btn-primary text-lg">
					<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
					</svg>
					{t(locale, 'contact.ask.discordButton')}
				</a>
				<a href={`mailto:${contactEmail}`} class="btn-secondary text-lg">
					<Mail class="w-5 h-5" aria-hidden="true" />
					{t(locale, 'contact.ask.emailButton')}
				</a>
			</div>
		</div>
	</section>

	</main>

	<Footer />
</body>
</html>

<style>
	.contact-forum-icon {
		display: block;
		width: 4rem;
		height: 4rem;
		background-color: currentColor;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: center;
		mask-position: center;
		-webkit-mask-size: contain;
		mask-size: contain;
	}
</style>
